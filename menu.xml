<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="Labwc">
    
    <!-- Main Applications -->
    <item label="Terminal">
      <action name="Execute">
        <command>kitty</command>
      </action>
    </item>
    
    <item label="Files (Yazi)">
      <action name="Execute">
        <command>kitty -e yazi</command>
      </action>
    </item>
    
    <item label="Brave Browser">
      <action name="Execute">
        <command>brave</command>
      </action>
    </item>

    <separator />

    <!-- Noctalia & Utilities -->
    <item label="App Launcher">
      <action name="Execute">
        <command>noctalia msg panel-toggle launcher</command>
      </action>
    </item>
    
    <item label="Session Panel">
      <action name="Execute">
        <command>noctalia msg panel-toggle session</command>
      </action>
    </item>

    <separator />

    <!-- Configuration with Nano -->
    <menu id="config-menu" label="Settings">
      <item label="Edit rc.xml">
        <action name="Execute">
          <command>kitty -e nano ~/.config/labwc/rc.xml</command>
        </action>
      </item>
      <item label="Edit themerc">
        <action name="Execute">
          <command>kitty -e nano ~/.config/labwc/themerc</command>
        </action>
      </item>
      <item label="Edit menu.xml">
        <action name="Execute">
          <command>kitty -e nano ~/.config/labwc/menu.xml</command>
        </action>
      </item>
      <item label="Edit autostart">
        <action name="Execute">
          <command>kitty -e nano ~/.config/labwc/autostart</command>
        </action>
      </item>
    </menu>

    <separator />

    <!-- Power & System Options -->
    <menu id="system-menu" label="System">
      <item label="Reload Labwc">
        <action name="Execute">
          <command>labwc -r</command>
        </action>
      </item>
      
      <separator />
      
      <item label="Shutdown">
        <action name="Execute">
          <command>systemctl poweroff</command>
        </action>
      </item>
      <item label="Reboot">
        <action name="Execute">
          <command>systemctl reboot</command>
        </action>
      </item>
      <item label="Log Out">
        <action name="Exit" />
      </item>
    </menu>

  </menu>
</openbox_menu>
