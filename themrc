# ==========================================
# MINIMALIST DARK THEME (TILING STYLE)
# ==========================================

# 1. GEOMETRY & BORDERS
border.width: 1
window.bounding.radius: 0

# Ultra-thin titlebar
window.titlebar.padding.width: 2
window.titlebar.padding.height: 1
window.button.width: 16
window.button.height: 16

# Border colors (Active: Light Gray, Inactive: Dark Gray)
window.active.border.color: #555555
window.inactive.border.color: #111111

# 2. SHADOWS: Completely disabled
window.active.shadow.size: 0
window.inactive.shadow.size: 0

# 3. WINDOW & TITLEBAR COLORS (70% Transparency)
window.active.title.bg.color: #000000B3
window.inactive.title.bg.color: #111111B3
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #555555
window.label.text.justify: center

# ==========================================
# UI ELEMENTS (OSD & Menus)
# ==========================================

# A. ALT+TAB DESIGN (Window Switcher)
osd.bg.color: #000000
osd.border.color: #333333
osd.border.width: 1
osd.label.text.color: #ffffff
osd.window-switcher.style-thumbnail.item.active.bg.color: #1a1a1a
osd.window-switcher.style-thumbnail.item.active.border.width: 1
osd.window-switcher.style-thumbnail.item.active.border.color: #555555

# B. SNAPPING ZONES
snapping.overlay.region.bg.color: #ffffff10
snapping.overlay.edge.bg.color: #ffffff10
snapping.overlay.region.border.width: 1
snapping.overlay.region.border.color: #444444

# C. CONTEXT MENU
menu.items.bg.color: #0a0a0a
menu.items.text.color: #ffffff
menu.items.active.bg.color: #222222
menu.items.active.text.color: #ffffff
menu.border.color: #333333
menu.border.width: 1
menu.separator.color: #333333
menu.items.padding.x: 8
menu.items.padding.y: 4
